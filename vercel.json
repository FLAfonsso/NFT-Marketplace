{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/((?!mockServiceWorker\.js$|assets/|.*\.[^/]+$).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/mockServiceWorker.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
